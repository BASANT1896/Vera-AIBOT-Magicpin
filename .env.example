# Copy to .env (or set as real env vars on your host) before deploying.
# The bot works with NO key set at all — it falls back to the deterministic
# composer — but composition quality is higher with an LLM configured.

LLM_PROVIDER=anthropic          # anthropic | openai | deepseek | gemini
ANTHROPIC_API_KEY=sk-ant-...    # only needed if LLM_PROVIDER=anthropic
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=...
# GEMINI_API_KEY=...
LLM_MODEL=                      # optional override, e.g. claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=18          # keep well under the judge's 30s call budget

TEAM_NAME=Team Vera Rebuild
TEAM_MEMBERS=Basant
TEAM_EMAIL=basant.ug23@nsut.ac.in

VERA_DB_PATH=./vera_state.db    # SQLite file; fine to leave as default
PORT=8080
